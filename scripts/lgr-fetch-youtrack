#!/usr/bin/env python3
"""Fetch bounded YouTrack issue context as Markdown."""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request


MAX_RESPONSE_BYTES = 1_048_576
ISSUE_PATTERN = re.compile(r"JT-\d+", re.IGNORECASE)


class SameOriginRedirectHandler(urllib.request.HTTPRedirectHandler):
    def __init__(self, origin: tuple[str, str]):
        self.origin = origin

    def redirect_request(self, request, fp, code, message, headers, new_url):
        parsed = urllib.parse.urlsplit(new_url)
        if (parsed.scheme.lower(), parsed.netloc.lower()) != self.origin:
            raise urllib.error.HTTPError(
                request.full_url,
                code,
                "refusing to send YouTrack credentials across origins",
                headers,
                fp,
            )
        return super().redirect_request(request, fp, code, message, headers, new_url)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Fetch YouTrack issue summaries and descriptions as Markdown."
    )
    parser.add_argument("base_url", help="YouTrack base URL")
    parser.add_argument("issues", nargs="+", help="JT-##### issue IDs")
    return parser.parse_args()


def fail(message: str) -> None:
    print(f"lgr-fetch-youtrack: {message}", file=sys.stderr)
    raise SystemExit(1)


def normalized_base_url(value: str) -> str:
    parsed = urllib.parse.urlsplit(value.rstrip("/"))
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        fail("base URL must use http or https")
    if parsed.query or parsed.fragment:
        fail("base URL must not contain a query or fragment")
    return urllib.parse.urlunsplit(parsed).rstrip("/")


def fetch_issue(
    opener: urllib.request.OpenerDirector,
    base_url: str,
    issue_id: str,
    token: str | None,
) -> dict[str, object]:
    query = urllib.parse.urlencode(
        {"fields": "idReadable,summary,description"}
    )
    endpoint = (
        f"{base_url}/api/issues/{urllib.parse.quote(issue_id, safe='')}?{query}"
    )
    headers = {"Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(endpoint, headers=headers)
    try:
        with opener.open(request, timeout=30) as response:
            raw = response.read(MAX_RESPONSE_BYTES + 1)
    except urllib.error.HTTPError as error:
        hint = (
            " Set YOUTRACK_TOKEN or YOUTRACK_API_KEY when the issue is private."
            if error.code in {401, 403, 404}
            else ""
        )
        fail(f"{issue_id} fetch returned HTTP {error.code}.{hint}")
    except urllib.error.URLError as error:
        fail(f"{issue_id} fetch failed: {error.reason}")
    if len(raw) > MAX_RESPONSE_BYTES:
        fail(f"{issue_id} response exceeds {MAX_RESPONSE_BYTES} bytes")
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        fail(f"{issue_id} response is not valid UTF-8 JSON: {error}")
    if not isinstance(value, dict):
        fail(f"{issue_id} response is not a JSON object")
    return value


def issue_markdown(base_url: str, requested_id: str, value: dict[str, object]) -> str:
    issue_id = value.get("idReadable")
    summary = value.get("summary")
    description = value.get("description")
    if not isinstance(issue_id, str) or not ISSUE_PATTERN.fullmatch(issue_id):
        fail(f"{requested_id} response lacks a valid idReadable")
    if not isinstance(summary, str) or not summary.strip():
        fail(f"{requested_id} response lacks a summary")
    if description is not None and not isinstance(description, str):
        fail(f"{requested_id} response has a non-text description")
    one_line_summary = " ".join(summary.splitlines()).strip()
    issue_url = f"{base_url}/issue/{urllib.parse.quote(issue_id, safe='-')}"
    body = description.strip() if description and description.strip() else "No description provided."
    return (
        f"# {issue_id} — {one_line_summary}\n\n"
        f"Source: {issue_url}\n\n"
        f"## Description\n\n{body}\n"
    )


def main() -> None:
    args = parse_args()
    base_url = normalized_base_url(args.base_url)
    parsed = urllib.parse.urlsplit(base_url)
    opener = urllib.request.build_opener(
        SameOriginRedirectHandler((parsed.scheme.lower(), parsed.netloc.lower()))
    )
    token = os.environ.get("YOUTRACK_TOKEN") or os.environ.get("YOUTRACK_API_KEY")
    issue_ids: list[str] = []
    for raw_issue in args.issues:
        issue_id = raw_issue.upper()
        if not ISSUE_PATTERN.fullmatch(issue_id):
            fail(f"invalid issue ID {raw_issue!r}; expected JT-#####")
        if issue_id not in issue_ids:
            issue_ids.append(issue_id)
    documents = [
        issue_markdown(base_url, issue_id, fetch_issue(opener, base_url, issue_id, token))
        for issue_id in issue_ids
    ]
    sys.stdout.write("\n---\n\n".join(documents))


if __name__ == "__main__":
    main()
