<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>lazy-git-review third-party licences</title>
  <style>
    body { font: 16px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { border: 1px solid #999; max-height: 24rem; overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <main>
    <h1>Project and dependency licences</h1>
    <p>lazy-git-review and its dependencies remain under their respective terms. This report was generated from Cargo.lock.</p>
    {{#each licenses}}
      <section>
        <h2 id="{{id}}-{{@index}}">{{name}}</h2>
        <p>Used by:</p>
        <ul>
          {{#each used_by}}
            <li>{{crate.name}} {{crate.version}}</li>
          {{/each}}
        </ul>
        <pre>{{text}}</pre>
      </section>
    {{/each}}
  </main>
</body>
</html>
